{
  "name": "@boxcompute/cli",
  "version": "0.2.5",
  "description": "Connect local AI agents to BoxCompute sandboxes",
  "keywords": [
    "boxcompute",
    "sandbox",
    "ai-agent",
    "cli"
  ],
  "homepage": "https://app.boxcompute.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boxcompute/cli.git"
  },
  "bugs": {
    "url": "https://github.com/boxcompute/cli/issues"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "bxc": "dist/cli.js",
    "bcompute": "dist/cli.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint --max-warnings 0 src test",
    "postinstall": "node --eval \"const fs = require('node:fs'); if (fs.existsSync('dist/postinstall.js')) import('./dist/postinstall.js')\"",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.0.0",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}
